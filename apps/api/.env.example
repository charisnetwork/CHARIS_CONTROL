# App Database (each app has its own PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bill_easy?schema=public"

# Redis (for BullMQ webhook worker + caching)
REDIS_URL="redis://localhost:6379"

# Control Centre Integration
CONTROL_CENTRE_URL="https://control.charisnetwork.com"
CONTROL_CENTRE_API_KEY="cc_app_xxxxxxxxxxxxxxxx"
CONTROL_CENTRE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# Entitlement Signing (RS256 - generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
ENTITLEMENT_PRIVATE_KEY_PATH="./keys/private.pem"
ENTITLEMENT_PUBLIC_KEY_PATH="./keys/public.pem"
ENTITLEMENT_KEY_ID="charis-entitlement-v1"
ENTITLEMENT_TTL_HOURS="24"

# App Identity (set per deployment)
APP_ID="bill-easy"
APP_NAME="Bill Easy"
APP_ENVIRONMENT="production"

# Server
PORT=4000
NODE_ENV="development"

# Security
CONTROL_API_SECRET="shared-secret-for-control-centre-calls"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
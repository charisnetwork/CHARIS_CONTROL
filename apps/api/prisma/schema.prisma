// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  HR
  ACCOUNTS
  MARKETING
  SUPPORT
  READ_ONLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  SUSPEND
  ACTIVATE
}

enum ApplicationEnvironment {
  PRODUCTION
  DEVELOPMENT
  SANDBOX
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  PERCENTAGE
  BOOLEAN
  DATE
  DATETIME
  DROPDOWN
  CHECKBOX
  RADIO
  JSON
  ARRAY
  TAGS
  ICON
  COLOR
  EMAIL
  PHONE
  URL
  IMAGE
  FILE
  OBJECT
  RELATION
  CUSTOM_TYPE
}

// ------------------------------------------------------
// CONTROL CENTER ADMIN MODELS
// ------------------------------------------------------

model AdminUser {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      AdminRole @default(READ_ONLY)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditLogs AuditLog[]
}

model Affiliate {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  email         String
  mobileNo      String
  status        String   @default("active") // active, inactive
  commissionPct Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coupons Coupon[]
}

model PlatformExpense {
  id          String   @id @default(uuid())
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalNotification {
  id             String       @id @default(uuid())
  title          String
  message        String       @db.Text
  targetAudience String       @default("all")
  priority       String       @default("normal")
  type           String       @default("in_app") // push, email, in_app
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id])
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ------------------------------------------------------
// SYSTEM MODELS (PLUG & PLAY REGISTRY)
// ------------------------------------------------------

model Application {
  id                   String                 @id @default(uuid())
  applicationName      String                 @unique
  displayName          String
  logo                 String?
  description          String?
  version              String?
  environment          ApplicationEnvironment @default(PRODUCTION)
  apiBaseUrl           String
  healthApi            String?
  customerApi          String?
  subscriptionApi      String?
  couponApi            String?
  notificationApi      String?
  authenticationMethod String?
  apiKey               String?                @unique
  apiSecret            String?
  status               ApplicationStatus      @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  coupons                Coupon[]
  offers                 Offer[]
  notifications          GlobalNotification[]
  mappings               ApplicationMapping[]
  subscriptionReferences SubscriptionReference[]
}

model AuditLog {
  id        String      @id @default(uuid())
  adminId   String?
  admin     AdminUser?  @relation(fields: [adminId], references: [id])
  action    AuditAction
  module    String
  targetId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
}

model ApiLog {
  id              String   @id @default(uuid())
  applicationName String
  endpoint        String
  method          String
  statusCode      Int
  responseTime    Int // in ms
  createdAt       DateTime @default(now())
}

// ------------------------------------------------------
// METADATA-DRIVEN SUBSCRIPTION PLATFORM
// ------------------------------------------------------

model SubscriptionModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billingModels BillingModel[]
  plans         Plan[]
  features      Feature[]
  versions      ModelVersion[]
  mappings      ApplicationMapping[]
}

model BillingModel {
  id                  String            @id @default(uuid())
  subscriptionModelId String
  subscriptionModel   SubscriptionModel @relation(fields: [subscriptionModelId], references: [id], onDelete: Cascade)
  name                String // e.g., Monthly, Per User, Custom
  description         String?
  cycleType           String // e.g., RECURRING, ONE_TIME, USAGE
  interval            String? // e.g., MONTH, YEAR, DAY
  intervalCount       Int? // e.g., 1
  metadata            Json? // Additional configuration
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Plan {
  id                  String            @id @default(uuid())
  subscriptionModelId String
  subscriptionModel   SubscriptionModel @relation(fields: [subscriptionModelId], references: [id], onDelete: Cascade)
  name                String // e.g., Free, Starter, Enterprise
  description         String?
  order               Int               @default(0)
  pricingMatrix       Json              @default("{}") // Maps BillingModel ID to Price
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  subscriptionReferences SubscriptionReference[]
}

model Feature {
  id                  String            @id @default(uuid())
  subscriptionModelId String
  subscriptionModel   SubscriptionModel @relation(fields: [subscriptionModelId], references: [id], onDelete: Cascade)
  name                String // e.g., Branches, Storage Limit
  code                String // e.g., max_branches
  description         String?
  category            String? // Group features visually

  fields    FeatureField[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model FeatureField {
  id           String    @id @default(uuid())
  featureId    String
  feature      Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  name         String
  code         String
  type         FieldType
  options      Json? // For dropdowns, radio buttons, tags
  defaultValue String?
  order        Int       @default(0)

  validationRules ValidationRule[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ValidationRule {
  id             String       @id @default(uuid())
  featureFieldId String
  featureField   FeatureField @relation(fields: [featureFieldId], references: [id], onDelete: Cascade)
  type           String // REQUIRED, MIN, MAX, REGEX, CONDITIONAL
  value          String? // e.g. "10", "^[a-z]+$"
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ModelVersion {
  id                  String            @id @default(uuid())
  subscriptionModelId String
  subscriptionModel   SubscriptionModel @relation(fields: [subscriptionModelId], references: [id], onDelete: Cascade)
  versionNumber       Int
  publishedAt         DateTime          @default(now())
  publishedBy         String? // Admin ID
  status              String            @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT

  publishedModels PublishedModel[]
}

model PublishedModel {
  id             String       @id @default(uuid())
  modelVersionId String
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  payload        Json // The massive flattened JSON metadata snapshot!
  hash           String // Checksum for integrity
  createdAt      DateTime     @default(now())
}

model ApplicationMapping {
  id                  String            @id @default(uuid())
  applicationId       String
  application         Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subscriptionModelId String
  subscriptionModel   SubscriptionModel @relation(fields: [subscriptionModelId], references: [id], onDelete: Cascade)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([applicationId, subscriptionModelId])
}

model Metadata {
  id         String   @id @default(uuid())
  entityType String // System-wide generic key-value store
  entityId   String
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, key])
}

model APIEndpoint {
  id          String   @id @default(uuid())
  name        String
  path        String   @unique
  method      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// COUPONS & OFFERS & MARKETING
// ------------------------------------------------------

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  affiliateId   String?
  affiliate     Affiliate?   @relation(fields: [affiliateId], references: [id])

  discountType    String    @default("percentage") // percentage, flat
  discountValue   Float     @default(0)
  maxUses         Int?
  usesCount       Int       @default(0)
  expiresAt       DateTime?
  applicablePlans Json      @default("[]") // Array of plan IDs (or Plan Codes)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  usages CouponUsage[]
}

model Offer {
  id            String       @id @default(uuid())
  title         String // e.g. "Festival Offer"
  banner        String?
  description   String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  status        String       @default("active") // active, inactive
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model MarketingCampaign {
  id          String   @id @default(uuid())
  name        String
  platform    String // Facebook, Google Ads, etc.
  budget      Float    @default(0)
  spent       Float    @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  leads       Int      @default(0)
  installs    Int      @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// SUBSCRIPTION SYNCHRONIZATION MODELS
// ------------------------------------------------------

model SubscriptionReference {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customerId      String // ID from the external application
  customerEmail   String?
  customerName    String?
  planId          String?
  plan            Plan?       @relation(fields: [planId], references: [id])
  status          String // TRIAL, ACTIVE, PAST_DUE, PAUSED, CANCELLED, EXPIRED
  price           Float?
  billingCycle    String? // MONTHLY, YEARLY
  startDate       DateTime?
  nextRenewalDate DateTime?
  paymentStatus   String? // PAID, FAILED, PENDING
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  events SubscriptionEvent[]
}

model SubscriptionEvent {
  id                      String                @id @default(uuid())
  subscriptionReferenceId String
  subscriptionReference   SubscriptionReference @relation(fields: [subscriptionReferenceId], references: [id], onDelete: Cascade)
  eventType               String // CREATED, RENEWED, CANCELLED, UPGRADED, DOWNGRADED, PAYMENT_FAILED
  previousPlanId          String?
  newPlanId               String?
  reason                  String?
  timestamp               DateTime              @default(now())
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId      String // ID from the external application
  applicationId   String
  discountApplied Float?
  usedAt          DateTime @default(now())
}
